{
  "name": "compteur",
  "main": "src/index.js",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      { "name": "REGISTRY", "class_name": "RegistryDO" },
      { "name": "EVENT",    "class_name": "EventDO"    }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RegistryDO", "EventDO"] }
  ]
}
