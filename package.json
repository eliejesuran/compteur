{
  "name": "compteur-evenement",
  "version": "1.0.0",
  "description": "Compteur de personnes temps réel pour événements",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "npm run test:local && npm run test:worker",
    "test:local": "node --test tests/*.test.js",
    "test:worker": "vitest run",
    "cf:dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "express": "^4.18.2",
    "qrcode": "^1.5.3",
    "ws": "^8.14.2"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.15",
    "supertest": "^7.2.2",
    "vitest": "^4.1.9",
    "wrangler": "^4.99.0"
  }
}
